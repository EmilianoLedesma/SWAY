# .env — Solo necesario en el SERVIDOR PRIVADO (10.10.10.2)
# El servidor público (Nginx + Uptime Kuma) NO requiere este archivo.
#
# Pasos:
#   cp .env.example .env
#   nano .env          # rellenar los valores reales
#   chmod 600 .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=sway_app
DB_PASSWORD=sway123
DB_NAME=sway

# ── JWT (FastAPI) ─────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REEMPLAZAR_CON_CLAVE_HEX_64_CHARS

# ── API Key ───────────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(24))"
# Compartir solo con clientes autorizados (app móvil, web frontend)
API_KEY=REEMPLAZAR_CON_CLAVE_HEX_48_CHARS

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password_de_16_caracteres

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes que pueden hacer peticiones desde el navegador.
# Incluir la IP pública del servidor Nginx (con https://) y el frontend web.
# Ejemplo con dos orígenes:
#   CORS_ORIGINS=https://192.168.1.50,http://192.168.1.30:5173
CORS_ORIGINS=https://IP_DEL_SERVIDOR_NGINX
